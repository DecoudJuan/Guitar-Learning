{
  "name": "guitar-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy-wasm",
    "prebuild": "npm run copy-wasm",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "neck-check": "esbuild scripts/neck-check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/neck-check.mjs --log-level=error && node node_modules/.cache/neck-check.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "description": "A guitar class that watches: the camera finds your fretboard and your hand and tells you which finger goes where."
}
